#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PY_SCRIPT="$SCRIPT_DIR/dsn2kicad.py"

if [ -n "${ORCAD2KICAD_VENV:-}" ]; then
    VENV_DIR=$ORCAD2KICAD_VENV
else
    if [ -n "${XDG_CACHE_HOME:-}" ]; then
        CACHE_ROOT=$XDG_CACHE_HOME
    elif [ -n "${HOME:-}" ] && [ "$(uname -s 2>/dev/null || echo unknown)" = "Darwin" ]; then
        CACHE_ROOT="$HOME/Library/Caches"
    elif [ -n "${HOME:-}" ]; then
        CACHE_ROOT="$HOME/.cache"
    else
        CACHE_ROOT=
    fi

    if [ -n "$CACHE_ROOT" ] && mkdir -p "$CACHE_ROOT/orcad2kicad" 2>/dev/null; then
        VENV_DIR="$CACHE_ROOT/orcad2kicad/venv"
    else
        TMP_ROOT=${TMPDIR:-/tmp}
        VENV_DIR="$TMP_ROOT/orcad2kicad-venv-${USER:-user}"
    fi
fi

if [ ! -x "$VENV_DIR/bin/python3" ]; then
    echo "Creating OrCAD2KiCad virtualenv at $VENV_DIR" >&2
    python3 -m venv "$VENV_DIR"
    "$VENV_DIR/bin/python3" -m pip install --quiet --upgrade pip
    "$VENV_DIR/bin/python3" -m pip install --quiet olefile freetype-py
fi

# freetype-py gives faithful text metrics; install it if this venv predates it.
"$VENV_DIR/bin/python3" -c "import freetype" 2>/dev/null \
    || "$VENV_DIR/bin/python3" -m pip install --quiet freetype-py

exec "$VENV_DIR/bin/python3" "$PY_SCRIPT" "$@"
