#!/bin/sh
# Copyright (C) 2026 Andrei Errapart
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Compile-and-cache launcher for the Haskell converter. Mirrors the cache-root
# resolution in scripts/dsn2kicad_py so both entrypoints behave the same way.
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
HS_SCRIPT="$SCRIPT_DIR/dsn2kicad.hs"

if [ -n "${ORCAD2KICAD_HS_CACHE:-}" ]; then
    CACHE_DIR=$ORCAD2KICAD_HS_CACHE
else
    if [ -n "${XDG_CACHE_HOME:-}" ]; then
        CACHE_ROOT=$XDG_CACHE_HOME
    elif [ -n "${HOME:-}" ] && [ "$(uname -s 2>/dev/null || echo unknown)" = "Darwin" ]; then
        CACHE_ROOT="$HOME/Library/Caches"
    elif [ -n "${HOME:-}" ]; then
        CACHE_ROOT="$HOME/.cache"
    else
        CACHE_ROOT=
    fi

    if [ -n "$CACHE_ROOT" ] && mkdir -p "$CACHE_ROOT/orcad2kicad" 2>/dev/null; then
        CACHE_DIR="$CACHE_ROOT/orcad2kicad/hs"
    else
        TMP_ROOT=${TMPDIR:-/tmp}
        CACHE_DIR="$TMP_ROOT/orcad2kicad-hs-${USER:-user}"
    fi
fi

# Content hash as the cache key: editing the source rebuilds automatically.
# Any digest will do -- the key only has to change when the source does -- so
# fall back through the tools a minimal system is likely to have.
if command -v shasum >/dev/null 2>&1; then
    STAMP=$(shasum -a 256 "$HS_SCRIPT")
elif command -v sha256sum >/dev/null 2>&1; then
    STAMP=$(sha256sum "$HS_SCRIPT")
elif command -v md5sum >/dev/null 2>&1; then
    STAMP=$(md5sum "$HS_SCRIPT")
elif command -v md5 >/dev/null 2>&1; then
    STAMP=$(md5 -q "$HS_SCRIPT")
else
    echo "dsn2kicad: no checksum tool found (tried shasum, sha256sum, md5sum, md5)." >&2
    echo "Install one, or use $SCRIPT_DIR/dsn2kicad_py for the Python converter." >&2
    exit 1
fi
STAMP=${STAMP%% *}
BINARY="$CACHE_DIR/dsn2kicad-$STAMP"

# Each cached binary is ~27 MB and content-addressed, so every edit of the
# source strands the previous one forever.  Sweep anything untouched for a day,
# along with build directories orphaned by an interrupted or killed compile.
# The binary this run needs is exempt and has its mtime refreshed below, so one
# in daily use is never evicted.
if [ -d "$CACHE_DIR" ]; then
    find "$CACHE_DIR" -maxdepth 1 ! -path "$CACHE_DIR" \
        ! -name "dsn2kicad-$STAMP" -mtime +0 \
        -exec rm -rf {} + 2>/dev/null || true
fi

if [ ! -x "$BINARY" ]; then
    if ! command -v ghc >/dev/null 2>&1; then
        echo "dsn2kicad: GHC not found." >&2
        echo "Install GHC, or use $SCRIPT_DIR/dsn2kicad_py for the Python converter." >&2
        exit 1
    fi
    mkdir -p "$CACHE_DIR"
    BUILD_DIR=
    cleanup_build()
    {
        if [ -n "$BUILD_DIR" ]; then
            rm -rf "$BUILD_DIR"
        fi
    }
    # Armed before mktemp runs: a signal arriving between the directory being
    # created and its name being recorded would otherwise strand it in the
    # cache, and only the daily sweep above would ever collect it.
    trap cleanup_build 0
    trap 'exit 1' HUP INT TERM
    BUILD_DIR=$(mktemp -d "$CACHE_DIR/.build-$STAMP.XXXXXX")

    mkdir -p "$BUILD_DIR/objects"
    echo "Compiling dsn2kicad (Haskell) at $BINARY" >&2
    ghc -O1 \
        -outputdir "$BUILD_DIR/objects" \
        "$HS_SCRIPT" \
        -o "$BUILD_DIR/dsn2kicad" >&2

    # BUILD_DIR is inside CACHE_DIR, so this publication is an atomic rename.
    # Concurrent first launches compile independently and may safely publish
    # the same content-addressed binary.
    mv -f "$BUILD_DIR/dsn2kicad" "$BINARY"
    cleanup_build
    trap - 0 HUP INT TERM
fi

# Records this binary as in use, so the sweep above keeps it for another day.
touch "$BINARY" 2>/dev/null || true

exec "$BINARY" "$@"
